# Development only. Next.js runs on :3000 and the Python API on :8000, so the browser
# needs to know where the API is. Copy this to .env.local for `npm run dev`.
#
# Leave it EMPTY (or delete the file) for a production build: FastAPI then serves the
# exported dashboard and the API from the same origin.
NEXT_PUBLIC_API_BASE=http://localhost:8000
