# Orbit environment template. Copy to .env and fill in. Never commit .env.
# In Replit, set these as Secrets instead of using a file.

# --- Core ---
DATABASE_URL=sqlite:///./orbit.db
TZ=Asia/Kuala_Lumpur

# Demo mode exposes the WhatsApp simulator and the role switcher. Set false for a real deployment.
DEMO_MODE=true

# --- Secrets (generate your own, these placeholders must not be used) ---
# Signs the simulated-login session cookie.
SESSION_SECRET=change-me
# Key for the phone-number lookup HMAC. Changing it invalidates every existing phone_hmac.
PHONE_HMAC_KEY=change-me
# Fernet key for the encrypted phone copy used to send replies.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHONE_ENC_KEY=

# --- Receipt extraction (the only place AI is used) ---
# mock = read labelled answers from seed/ground_truth.csv, no network call. claude = Claude vision.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=

# --- WhatsApp Cloud API (optional) ---
# Leave ALL FOUR of these blank/default and Orbit runs on the built-in simulator,
# which posts the same webhook payload shape. That is the demo path.
#
# Setting WHATSAPP_TOKEN and WHATSAPP_PHONE_ID together is what switches Orbit to
# the real Meta Cloud API: outbound messages are POSTed to Meta, and inbound
# receipt images are downloaded from Meta by media id. UNVERIFIED: that live path
# has never been exercised against a real Meta account.
#
# Permanent system-user access token from Meta Business Settings.
WHATSAPP_TOKEN=
# The Cloud API "Phone number ID" (a number, not the phone number itself),
# from Meta App Dashboard -> WhatsApp -> API Setup. Verify in the console.
WHATSAPP_PHONE_ID=
# Any string you choose. Paste the same value into Meta's webhook setup form, which
# echoes it back to GET /webhooks/whatsapp during the verification handshake.
WHATSAPP_VERIFY_TOKEN=orbit-verify
# App Secret from Meta App Dashboard -> App Settings -> Basic. When set, every
# inbound webhook POST must carry a matching X-Hub-Signature-256 or it is rejected
# with 401. When blank, signatures are not checked (simulator mode).
WHATSAPP_APP_SECRET=
