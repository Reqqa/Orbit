# Orbit environment template. Copy to .env and fill in. Never commit .env.
# In Replit, set these as Secrets instead of using a file.

# --- Core ---
DATABASE_URL=sqlite:///./orbit.db
TZ=Asia/Kuala_Lumpur

# Demo mode exposes the WhatsApp simulator and the role switcher. Set false for a real deployment.
DEMO_MODE=true

# --- Secrets (generate your own, these placeholders must not be used) ---
# Signs the simulated-login session cookie.
SESSION_SECRET=change-me
# Key for the phone-number lookup HMAC. Changing it invalidates every existing phone_hmac.
PHONE_HMAC_KEY=change-me
# Fernet key for the encrypted phone copy used to send replies.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHONE_ENC_KEY=

# --- Receipt extraction (the only place AI is used) ---
# mock = read labelled answers from seed/ground_truth.csv, no network call. claude = Claude vision.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
